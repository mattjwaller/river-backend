PORT=3000
DATABASE_URL=
ADMIN_API_KEY=
RIVERWATCH_API_KEY=
# Existing key remains supported until the RiverWatch proxy and Pi tokens are live.
API_KEY=
ALLOW_LEGACY_API_KEY=true
CORS_ORIGINS=https://your-riverwatch-origin.example
UPSTREAM_USER_AGENT=RiverWatch/2.0 contact@example.com
# Optional: delivery remains disabled until both values are supplied.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# Enable only after reviewing and backing up retained data.
ENABLE_DATA_RETENTION=false
